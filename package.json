{
  "name": "@mohtasham/md-to-docx",
  "version": "4.7.0",
  "description": "Convert Markdown to Microsoft Word (.docx) documents with support for various Markdown features",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#secure-image-fetch": {
      "browser": "./dist/utils/secureImageFetch.browser.js",
      "node": "./dist/utils/secureImageFetch.node.js",
      "default": "./dist/utils/secureImageFetch.browser.js"
    },
    "#image-assets": {
      "browser": "./dist/utils/imageAssets.browser.js",
      "node": "./dist/utils/imageAssets.node.js",
      "default": "./dist/utils/imageAssets.browser.js"
    }
  },
  "bin": {
    "md-to-docx": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "guardrails": "node scripts/guardrails.mjs",
    "fallow": "fallow --fail-on-issues --coverage coverage/coverage-final.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser-bundle": "npm run build && node tests/browser-bundle.mjs",
    "test:consumer": "node tests/package-consumer.mjs",
    "test:package-managers": "node tests/package-manager-consumer.mjs pnpm && node tests/package-manager-consumer.mjs bun",
    "test:package-manager": "node tests/package-manager-consumer.mjs",
    "test:single": "vitest run",
    "prepare": "npm run build",
    "release": "semantic-release",
    "preview:code-highlighting": "npm run build && node scripts/preview-code-highlighting.mjs",
    "ci": "npm run guardrails && npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run fallow && npm run test:consumer && npm run test:browser-bundle"
  },
  "keywords": [
    "markdown",
    "docx",
    "word",
    "converter",
    "typescript"
  ],
  "author": "Mohtasham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohtashamMurshid/md-to-docx.git"
  },
  "bugs": {
    "url": "https://github.com/MohtashamMurshid/md-to-docx/issues"
  },
  "homepage": "https://github.com/MohtashamMurshid/md-to-docx#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/file-saver": "2.0.7",
    "@types/hast": "3.0.5",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-v8": "4.1.12",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "9.39.5",
    "fallow": "3.43.1",
    "globals": "17.14.0",
    "next": "15.5.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "semantic-release": "25.0.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@xmldom/xmldom": "^0.9.10",
    "docx": "^9.15.4",
    "file-saver": "^2.0.5",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "undici": "^6.28.1",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss": "8.5.28"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  }
}
